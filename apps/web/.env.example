# Convex
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same as VITE_CONVEX_URL but ends in .site (optional; derived from VITE_CONVEX_URL if unset)
VITE_CONVEX_SITE_URL=
# Set this to true only after both Google OAuth secrets (see packages/backend/.env.example) are set on
# the Convex deployment. Leave false to use email/password authentication only.
VITE_GOOGLE_AUTH_ENABLED=false
# Vercel only — production/preview deploy key from Convex dashboard
# (Settings → Deploy Key). Must be CONVEX_DEPLOY_KEY, not CONVEX_DEPLOYMENT.
# Example: prod:knowing-shrimp-222|eyJ...
# CONVEX_DEPLOY_KEY=

# PostHog (optional analytics)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
