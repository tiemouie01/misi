# Copy to .env.local and fill in values:
#   cp .env.template .env.local

# Convex Cloud deployment URL (from `npx convex dev` / dashboard)
# Example: https://happy-animal-123.convex.cloud
VITE_CONVEX_URL=

# PowerSync Cloud instance URL (from the PowerSync dashboard)
# Example: https://<instance-id>.powersync.journeyapps.com
VITE_POWERSYNC_URL=

# The Convex connection (deployment URL + deploy key) and the Better Auth
# JWKS URL are configured in the PowerSync Cloud dashboard, not here.
# See powersync/README.md for the setup steps.
