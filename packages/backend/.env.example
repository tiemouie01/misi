# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same as VITE_CONVEX_URL but ends in .site (optional; derived from VITE_CONVEX_URL if unset)
VITE_CONVEX_SITE_URL=

# Convex deployment environment variables (set via `npx convex env set`)
# Required by Better Auth; use the public origin of this app.
# SITE_URL=http://localhost:3000
# Optional Google OAuth: set both secrets or leave both unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
