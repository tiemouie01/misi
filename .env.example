# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same as VITE_CONVEX_URL but ends in .site
VITE_CONVEX_SITE_URL=
# Local site URL (also set SITE_URL on the Convex deployment)
VITE_SITE_URL=http://localhost:3000

# Google OAuth (set on the Convex deployment via `npx convex env set`)
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# PowerSync
# PowerSync instance URL (required)
VITE_POWERSYNC_URL=
# Client-visible development token for local testing; VITE_* env vars are exposed to the browser
VITE_POWERSYNC_TOKEN=
