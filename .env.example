# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same as VITE_CONVEX_URL but ends in .site (optional; derived from VITE_CONVEX_URL if unset)
VITE_CONVEX_SITE_URL=
# Set this to true only after both Google OAuth secrets below are configured on
# the Convex deployment. Leave false to use email/password authentication only.
VITE_GOOGLE_AUTH_ENABLED=false
# Vercel only — production/preview deploy key from Convex dashboard
# (Settings → Deploy Key). Must be CONVEX_DEPLOY_KEY, not CONVEX_DEPLOYMENT.
# Example: prod:knowing-shrimp-222|eyJ...
# CONVEX_DEPLOY_KEY=

# Convex deployment environment variables (set via `npx convex env set`)
# Required by Better Auth; use the public origin of this app.
# SITE_URL=http://localhost:3000
# Optional Google OAuth: set both secrets or leave both unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google

# PostHog (optional analytics)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
