# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same as VITE_CONVEX_URL but ends in .site (optional; derived from VITE_CONVEX_URL if unset)
VITE_CONVEX_SITE_URL=
# Local site URL (also set SITE_URL on the Convex deployment)
VITE_SITE_URL=http://localhost:3000
# Vercel only — production/preview deploy key from Convex dashboard
# (Settings → Deploy Key). Must be CONVEX_DEPLOY_KEY, not CONVEX_DEPLOYMENT.
# Example: prod:knowing-shrimp-222|eyJ...
# CONVEX_DEPLOY_KEY=

# Google OAuth (set on the Convex deployment via `npx convex env set`)
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# PowerSync
# PowerSync instance URL (required)
VITE_POWERSYNC_URL=
# Client-visible development token for local testing; VITE_* env vars are exposed to the browser
VITE_POWERSYNC_TOKEN=
