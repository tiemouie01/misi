{
  "name": "misi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @misi/web dev",
    "dev:backend": "pnpm --filter @misi/backend dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @misi/shared test",
    "format": "prettier --write . && pnpm -r run lint --fix",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
